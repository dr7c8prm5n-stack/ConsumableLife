<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos 퍼미션: 읽기 전용 4개 (AC-P). CONTROL_*(제어)·PRIVATE_*(시스템 앱 전용)는 선언하지 않음 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- Odometer: 누적 주행거리, 누적 트립 거리·시간 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- Safety: 오일 레벨·워셔액·출력 제한 / Tire: 저압 기준 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />    <!-- CarInfo, Display -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />  <!-- EvBattery: 고전압 배터리 충전량(SOC) 읽기 -->
    <!-- FR-N01 상태 변화 알림 (foreground에서만 발행) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- NFR-05: INTERNET 권한 미사용 -->

    <application
        android:name=".app.ConsumableLifeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConsumableLife"
        tools:targetApi="34">

        <!-- CCP(로터리) 미지원 선언 — 터치 전용 (FR-L03, Q6) -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <uses-library android:name="android.car" android:required="false" />

        <!-- MVP: distractionOptimized 선언하지 않음 → 주행 중 시스템이 차단 (3장) -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
